# local-agent-kit configuration. Copy to config.env and edit:
#   cp config.env.example config.env
# `lak` sources ./config.env (or $LAK_CONFIG) before every command.
# Values may reference $HOME and earlier variables.

# --- Paths -----------------------------------------------------------------
# Directory holding your GGUF files.
LAK_MODELS_DIR="$HOME/models"
# Where `lak install-llama` clones and builds llama.cpp.
LAK_LLAMA_DIR="$HOME/.local/share/local-agent-kit/llama.cpp"
# Directory containing llama-server (default: the build output of the line above).
LAK_LLAMA_BIN="$LAK_LLAMA_DIR/build/bin"
# llama-swap binary (installed by `lak install-swap`).
LAK_SWAP_BIN="$HOME/.local/bin/llama-swap"
# Optional CUDA toolkit location used when building llama.cpp.
LAK_CUDA_HOME="/usr/local/cuda"

# --- Endpoint --------------------------------------------------------------
LAK_HOST=127.0.0.1
LAK_PORT=8080
# Internal port llama-swap uses for the llama-server it spawns.
LAK_UPSTREAM_PORT=9003

# --- Model -----------------------------------------------------------------
# The single alias every agent role (main/small/title/compaction) points at.
# One GPU holds one model: different aliases mean 25-40 s reloads.
LAK_MODEL_ALIAS=qwen36
LAK_MODEL_FILE="Qwen3.6-35B-A3B-UD-Q4_K_M.gguf"
LAK_CTX=131072
# Number of MoE layers whose experts stay in system RAM (see `lak tune`).
LAK_NCPUMOE=27
LAK_REASONING_BUDGET=256
LAK_OUTPUT_LIMIT=8192

# --- Build -----------------------------------------------------------------
# 86 = RTX 30xx, 89 = RTX 40xx, 120 = RTX 50xx, 75 = RTX 20xx.
CUDA_ARCH=86
